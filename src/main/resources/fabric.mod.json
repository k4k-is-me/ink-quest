{
	"schemaVersion": 1,
	"id": "travelcore-questing",
	"version": "${version}",
	"name": "InkQuest",
	"description": "A narrative-driven quest system for Minecraft. Design and deliver rich quests through datapacks or in-game commands — with stages, conditions, lifecycle hooks, and a built-in quest book.",
	"authors": [
		"Kuchukov"
	],
	"license": "CC-BY-NC-3.0",
	"icon": "assets/travelcorequesting/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"k4k.travelcorequesting.TravelcoreQuesting"
		],
		"client": [
			"k4k.travelcorequesting.TravelcoreQuestingClient"
		]
	},
	"mixins": [
		"travelcore-questing.mixins.json",
		"travelcore-questing-client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}